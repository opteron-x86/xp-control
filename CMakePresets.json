{
  "version": 6,
  "configurePresets": [
    {
      "name": "native-tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XPCONTROL_BUILD_PLUGIN": "OFF",
        "XPCONTROL_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Werror -fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "windows-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "XPCONTROL_BUILD_PLUGIN": "ON",
        "XPCONTROL_BUILD_TESTS": "ON",
        "CMAKE_C_COMPILER": "clang-cl"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-tests",
      "configurePreset": "native-tests"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    }
  ],
  "testPresets": [
    {
      "name": "native-tests",
      "configurePreset": "native-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
